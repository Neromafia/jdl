# Mẫu cấu hình TOML cho Streamlit Cloud (Settings -> Secrets)
# Copy toàn bộ nội dung từ .streamlit/secrets.toml hoặc điền thông tin bên dưới:

[gcp_service_account]
type = "service_account"
project_id = "jingdong-505914"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = """-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----
"""
client_email = "YOUR_CLIENT_EMAIL"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CERT_URL"

# Cấu hình Zalo Bot cảnh báo đơn hàng SLA vào Nhóm Chat Zalo
[zalo]
# Cách 1: Sử dụng Webhook URL của Nhóm Zalo (nếu nhóm Zalo có cài bot webhook)
webhook_url = "https://your-zalo-webhook-url"

# Cách 2: Sử dụng Zalo OpenAPI chính thức (Zalo OA quản lý nhóm)
access_token = "YOUR_ZALO_ACCESS_TOKEN"
group_id = "YOUR_ZALO_GROUP_ID"

# Bật/tắt cảnh báo tự động
enabled = true

# Ngưỡng cảnh báo cận hạn (1.0 = cảnh báo các đơn còn <= 1 tiếng nữa là đến hạn)
urgent_hours = 1.0

# Thời gian chờ chống spam tin nhắn lặp lại vào nhóm (phút)
cooldown_minutes = 30.0
