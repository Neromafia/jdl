# Biến môi trường cho JDL Sync & Zalo Bot (Dùng khi triển khai Cloud / Docker / VPS)

# 1. Zalo Bot Configuration
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=

# 2. Gemini AI Key (Dành cho trợ lý kho AI)
GEMINI_API_KEY=

# 3. Google Cloud Service Account (Dán toàn bộ nội dung JSON thành 1 dòng nếu không mount file)
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
